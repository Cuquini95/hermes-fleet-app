{
  "rewrites": [
    { "source": "/signature-tomas.png", "destination": "/api/removed-asset" },
    { "source": "/hermes-api/ai/diagnose", "destination": "/api/hermes-ai/diagnose" },
    { "source": "/hermes-api/ai/manual_lookup", "destination": "/api/hermes-ai/manual_lookup" },
    { "source": "/hermes-api/ai/photo_to_failure", "destination": "/api/hermes-ai/photo_to_failure" },
    { "source": "/hermes-api/ai/fault_code_pages", "destination": "/api/hermes-vps-gate?upstreamPath=/hermes-api/ai/fault_code_pages" },
    {
      "source": "/hermes-api/api/sheets/:path*",
      "destination": "/api/hermes-sheets-gate?upstreamPath=/hermes-api/api/sheets/:path*"
    },
    { "source": "/hermes-api/api/ocr/:path*", "destination": "/api/hermes-vps-gate?upstreamPath=/hermes-api/api/ocr/:path*" },
    { "source": "/hermes-api/api/push/:path*", "destination": "/api/hermes-vps-gate?upstreamPath=/hermes-api/api/push/:path*" },
    { "source": "/hermes-api/health", "destination": "https://5-78-204-80.sslip.io/hermes-api/health" },
    { "source": "/hermes-api/parts", "destination": "/api/hermes-vps-gate?upstreamPath=/hermes-api/parts" },
    { "source": "/hermes-api/diagrams/:path*", "destination": "https://5-78-204-80.sslip.io/hermes-api/diagrams/:path*" },
    { "source": "/hermes-api/:path*", "destination": "/api/hermes-vps-gate?upstreamPath=/hermes-api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://hermes-fleet-app.vercel.app https://5-78-204-80.sslip.io https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://*.sentry.io; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
