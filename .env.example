# Copy this file to .env and fill in your values
# Never commit .env to git

# Google Sheets proxy / VPS API server (FastAPI backend)
VITE_HERMES_API_URL=http://localhost:8000

# Supabase (photo storage + realtime)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Web Push VAPID public key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Server-side only for /api/auth/login. Do not prefix with VITE_.
# HERMES_AUTH_USERS_JSON is an array of username/role/user_name/assigned_units/password_sha256 records.
HERMES_AUTH_USERS_JSON=
HERMES_AUTH_SESSION_SECRET=

# Server-side only for /api/brain/* Vercel functions
GTP_BRAIN_URL=
GTP_BRAIN_TOKEN=
