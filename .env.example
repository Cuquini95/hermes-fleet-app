# Copy this file to .env and fill in your values
# Never commit .env to git

# Google Sheets proxy / VPS API server (FastAPI backend)
# Keep empty in normal development/production so requests use the authenticated same-origin gateway.
VITE_HERMES_API_URL=

# Server-side Hermes authentication and protected upstream proxy.
# PIN hashes use salt:scrypt_hex and must not reuse historical demo PINs.
HERMES_AUTH_SECRET=replace-with-at-least-32-random-characters
HERMES_PIN_HASH_OPERADOR=replace-with-salt:scrypt_hex
HERMES_PIN_HASH_MECANICO=replace-with-salt:scrypt_hex
HERMES_PIN_HASH_JEFE_TALLER=replace-with-salt:scrypt_hex
HERMES_PIN_HASH_COORDINADOR=replace-with-salt:scrypt_hex
HERMES_PIN_HASH_SUPERVISOR=replace-with-salt:scrypt_hex
HERMES_PIN_HASH_GERENCIA=replace-with-salt:scrypt_hex
HERMES_ASSIGNED_UNITS_OPERADOR=
HERMES_ASSIGNED_UNITS_SUPERVISOR=
HERMES_UPSTREAM_URL=https://replace-with-private-hermes-origin/hermes-api
HERMES_UPSTREAM_TOKEN=replace-with-a-random-upstream-gateway-token

# Supabase (photo storage + realtime)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Web Push VAPID public key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Hermes WhatsApp escalation/contact channel shown inside Intelligent Chat
VITE_HERMES_WHATSAPP_NUMBER=+507XXXXXXXX

# Server-side visual diagnosis for Hermes Chat photos.
# Do not expose these keys with VITE_; they must stay server-side in Vercel.
OPENROUTER_API_KEY=replace-with-server-side-openrouter-key
HERMES_DIAGNOSE_PROVIDER=openrouter
HERMES_DIAGNOSE_MODEL=xiaomi/mimo-v2.5-pro
HERMES_PHOTO_ANALYSIS_PROVIDER=openrouter
HERMES_VISION_MODEL=qwen/qwen3.7-plus
# Optional fallback provider:
OPENAI_API_KEY=replace-with-server-side-openai-key

# Server-side OpsOS intake proxy for Hermes Intelligent Chat
OPSOS_INTAKE_URL=http://localhost:3000
OPSOS_INTAKE_SECRET=replace-with-same-value-as-INTAKE_SHARED_SECRET

# Server-side CMMS bridge for fault reports.
CMMS_API_BASE=https://gtp-cmms.vercel.app
CMMS_HERMES_INGEST_SECRET=replace-with-same-value-as-CMMS_HERMES_INGEST_SECRET-in-cmms
# Optional fallback: a CMMS JWT with hermes_system role.
CMMS_HERMES_SYSTEM_TOKEN=replace-with-server-side-cmms-hermes-system-token
